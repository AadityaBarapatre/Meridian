{
  "name": "exchange",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "server": "tsx server/server.ts",
    "client": "vite",
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "build:ui": "vite build",
    "build:server": "esbuild server/server.ts --bundle --platform=node --format=cjs --outfile=electron/server.cjs --external:bufferutil --external:utf-8-validate",
    "desktop": "npm run build:ui && npm run build:server && electron .",
    "dist": "electron-builder",
    "test": "tsx test/engine.test.ts && tsx test/market.test.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  },
  "build": {
    "appId": "com.exchange.app",
    "productName": "Exchange",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}